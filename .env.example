# Next.js server-only proxy target. Docker Compose overrides this to http://api:8000.
FASTAPI_URL=http://127.0.0.1:8000

# Compose database credentials; development only. Use a URI-safe password.
POSTGRES_PASSWORD=repolens_local

# Standalone Python defaults. Compose supplies PostgreSQL + Redis automatically.
# These values are read relative to the working directory of the API process.
DATABASE_URL=sqlite:///./repolens.db
REDIS_URL=
SEED_DEMO=true
ENVIRONMENT=development

# Default: Groq for on-demand answers; all indexing uses keyword search without AI.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
RETRIEVAL_MODE=lexical
MAX_OUTPUT_TOKENS=1200
EVIDENCE_CHAR_BUDGET=7000
HISTORY_CHAR_BUDGET=2000
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_TTL_SECONDS=3600

# Optional alternative: LLM_PROVIDER=gemini. Hybrid search requires RETRIEVAL_MODE=hybrid.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional alternative; used only when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Optional GitHub token for server API requests and higher GitHub rate limits.
GITHUB_TOKEN=

# Optional GitHub OAuth application. Keep these values on the API server only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/backend/v1/auth/github/callback
TOKEN_ENCRYPTION_KEY=
# Generate a persistent random secret before saving live work; see README.
SESSION_SECRET=
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ingestion and budget limits.
MAX_FILES=150
MAX_FILE_BYTES=150000
MAX_REPOSITORY_BYTES=8000000
REQUESTS_PER_MINUTE=90
MESSAGES_PER_MINUTE=12
INDEXING_PER_HOUR=10
