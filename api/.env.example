# Copy to api/.env for the Python-only local workflow. Do not commit real keys.
DATABASE_URL=sqlite:///./repolens.db
REDIS_URL=
# Groq chat with zero-AI keyword indexing by default.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
RETRIEVAL_MODE=lexical
MAX_OUTPUT_TOKENS=1200
EVIDENCE_CHAR_BUDGET=7000
HISTORY_CHAR_BUDGET=2000
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_TTL_SECONDS=3600
# Optional Gemini alternative; hybrid embeddings require RETRIEVAL_MODE=hybrid.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional alternative; used only when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/backend/v1/auth/github/callback
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SEED_DEMO=true
ENVIRONMENT=development
